# Editor settings for every editor that reads EditorConfig. It is the working
# tree side of what .gitattributes does for the index.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown. Do not trim them
# without a check; `cargo xtask check text` allows them only in .md files.
trim_trailing_whitespace = false

[*.{rs,sh}]
indent_size = 4
