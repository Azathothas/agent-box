#!/bin/sh
# commit-msg: refuse a commit message that credits a tool, before the commit
# exists.
#
# The defect this hook exists to catch: a commit message that names the tool
# that wrote it, or that has a credit line that a tool adds by default.
#
# The gate cannot catch this defect in time. `cargo xtask check attribution`
# reads `git log`, and the new commit is not in the log while the gate runs.
# The check finds the defect only after git makes the commit, and maybe after
# a push. This hook reads the message before git makes the commit.
#
# Arm the hook. git does not clone hooks, so a fresh clone has no hook until
# you run one of these commands:
#
#   cargo xtask setup
#   git config core.hooksPath .githooks
#
# The hook is self-contained. It does not call cargo or a script of this
# repository, so it works in a fresh clone before the first build. It needs
# only sh, sed, grep and printf.
#
# NOTE: git refuses the commit for each exit code other than 0. Thus the hook
# has two honest answers: "checked and allowed", and "not allowed". When the
# hook cannot read the message, it refuses the commit. It never allows a
# message that it did not read.
#
# NOTE: The hook finds known shapes and known names only. A message that
# credits a tool in other words passes. docs/conventions.md gives the rule.
#
# NOTE: The hook also refuses a message that uses a listed name as a plain
# word (for example "cursor"), or that says a file is "generated by" a build
# step. Write the message in other words.
#
# Exit codes: 0 the message is allowed, 1 the message is refused, 2 the check
# could not run.
#
# SPDX-License-Identifier: 0BSD

set -u

# The hook compares bytes. With LC_ALL=C, sed and grep read each byte in the
# same way in every locale, and invalid UTF-8 cannot stop them.
LC_ALL=C
export LC_ALL

if [ $# -lt 1 ]; then
    printf 'commit-msg: git did not give the message file as the first argument.\n' >&2
    printf 'The message was NOT checked.\n' >&2
    exit 2
fi
MSG=$1
if [ ! -r "$MSG" ]; then
    printf 'commit-msg: cannot read %s. The message was NOT checked.\n' "$MSG" >&2
    exit 2
fi

# git removes the comment lines after this hook runs, so the hook removes them
# too. The template that git writes into the file names the branch and the
# files. A name in that template is not part of the message.
if ! BODY=$(sed -e 's/^#.*//' "$MSG"); then
    printf 'commit-msg: sed could not read %s. The message was NOT checked.\n' "$MSG" >&2
    exit 2
fi

# The four shapes of a credit. Each one comes from a default that nobody
# chose, so this is a hard rule and not a preference.
#
# 1. A co-author trailer. git reads a trailer key in any case.
TRAILER='^[[:space:]]*co-authored-by[[:space:]]*:'
# 2. A generated-with line.
GENERATED='(generated (with|by)|created (with|by) an? (ai|assistant|agent))'
# 3. The robot emoji (U+1F916). printf makes it from its four UTF-8 bytes, so
#    this file stays ASCII.
ROBOT=$(printf '\360\237\244\226')
# 4. The name of a tool or a vendor, as a whole word in any case.
NAMES='(^|[^[:alnum:]_])(claude|anthropic|copilot|chatgpt|openai|gemini|cursor|devin|codex|aider)([^[:alnum:]_]|$)'

# Exit status 0 when the message matches, 1 when it does not. grep gives a
# status above 1 for an error. Then the hook stops with exit 2, because a
# failed search is not a clean message.
matches() {
    printf '%s\n' "$BODY" | grep -q "$@"
    rc=$?
    if [ "$rc" -gt 1 ]; then
        printf 'commit-msg: grep stopped with status %s. The message was NOT checked.\n' "$rc" >&2
        exit 2
    fi
    return "$rc"
}

refuse() {
    printf 'commit-msg: refused: %s\n' "$1" >&2
    printf '\n' >&2
    printf 'git did not make the commit. Edit the message, then commit again.\n' >&2
    printf 'The repository owner is the only author of each commit. The default\n' >&2
    printf 'of a tool does not change this. docs/conventions.md gives the rule.\n' >&2
    exit 1
}

if matches -E -i -e "$TRAILER"; then
    refuse 'the message has a co-author trailer.'
fi
if matches -E -i -e "$GENERATED"; then
    refuse 'the message says that a tool generated it.'
fi
if matches -F -e "$ROBOT"; then
    refuse 'the message has the robot emoji.'
fi
if matches -E -i -e "$NAMES"; then
    refuse 'the message names a tool or a vendor.'
fi

exit 0
